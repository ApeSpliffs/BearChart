# Copy to .env and fill in. .env is gitignored and never printed.
#
# eBay: developer.ebay.com -> your application keys -> PRODUCTION keyset.
# App ID is the client id; Cert ID is the client secret. Sandbox keys will not
# work against api.ebay.com and fail with a confusing auth error.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Stripe, only once you are taking payments. The secret key belongs in Supabase
# secrets for the edge functions, not here - this is for local tooling only.
# STRIPE_SECRET_KEY=
