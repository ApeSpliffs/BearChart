# Copy to .env (gitignored). Local tooling only - deploy values live in Netlify,
# Supabase secrets and GitHub secrets (see docs/ENVIRONMENTS.md).

# eBay PRODUCTION keyset (sandbox keys fail against api.ebay.com).
# developer.ebay.com -> application keys: App ID = client id, Cert ID = secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Which environment local builds pretend to be: development | preview | production
BEARCHART_ENV=development

# Optional: point a local build (tools/build_site.sh) at a Supabase project.
# Leave empty to use the local CLI stack / data.json config.
BEARCHART_SUPABASE_URL=
BEARCHART_SUPABASE_ANON_KEY=

# Optional error reporting / analytics for local builds (normally left empty).
BEARCHART_SENTRY_DSN=
BEARCHART_POSTHOG_KEY=

# eBay account-deletion endpoint (api/ebay-deletion.js), for `netlify dev` only.
# It also uses EBAY_CLIENT_ID / EBAY_CLIENT_SECRET above to verify signatures.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=

# Backups (tools only; the workflow uses GitHub secrets). Session pooler URL.
# BACKUP_DATABASE_URL=

# Stripe secret keys never go here - they are Supabase function secrets.
