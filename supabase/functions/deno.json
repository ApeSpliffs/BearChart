{
  "imports": {
    "@sentry/deno": "npm:@sentry/deno@11.5.0",
    "@std/assert": "jsr:@std/assert@1"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "tasks": {
    "check": "deno check */index.ts _shared/ _tests/",
    "lint": "deno lint",
    "test": "deno test --no-prompt",
    "ci": "deno task check && deno task lint && deno task test"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "compilerOptions": {
    "types": [
      "npm:@types/node@*"
    ]
  }
}