# Generated by tools/build_pages.py - one file per catalogued item, rebuilt
# from data.json on every build. Deploy them; do not review them.
/item/
/sitemap.xml
/robots.txt

# Generated by tools/build_assets.js from data.json (npm run build:assets):
# the site manifest and the split catalogue the browser loads.
/site-config.js
/data/
# Retired: the whole catalogue as one script. Pages load the split files above.
/data.js
# Generated by tools/build_pwa.py: it precaches the files above by hash.
/sw.js

# Build output assembled by tools/build_site.sh.
/dist/

# Python bytecode.
__pycache__/
*.pyc

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env
# Vercel CLI
.vercel/
# Never commit env files other than the example
.env.*
!.env.example
.DS_Store
